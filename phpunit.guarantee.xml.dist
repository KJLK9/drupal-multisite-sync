<?xml version="1.0" encoding="UTF-8"?>
<!--
  The guarantee tests of the import engine: scenarios over the whole chain that
  are heavy, so that they are not part of "ddev composer check" or CI. Run them
  with "ddev composer verify" before a commit (docs/decisions/0030).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="web/core/tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true">
  <php>
    <ini name="error_reporting" value="32767"/>
    <ini name="memory_limit" value="-1"/>
    <env name="SIMPLETEST_BASE_URL" value="http://web"/>
    <env name="SIMPLETEST_DB" value="mysql://db:db@db/db"/>
    <env name="BROWSERTEST_OUTPUT_DIRECTORY" value="/tmp"/>
  </php>
  <testsuites>
    <testsuite name="guarantee">
      <directory>web/modules/custom/*/*/tests/src/Guarantee</directory>
    </testsuite>
  </testsuites>
</phpunit>
