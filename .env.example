# Copy to .env (git-ignored) and fill in. Real environment variables win over
# this file, which is how CI and production should provide them.
# Variables are prefixed with the upper-cased site directory: SITE_A_, SITE_B_.
# Generate a salt with: openssl rand -base64 55 | tr -d '\n=' | tr '+/' '-_'

SITE_A_DB_NAME=
SITE_A_DB_USER=
SITE_A_DB_PASSWORD=
SITE_A_DB_HOST=
SITE_A_DB_PORT=3306
SITE_A_HASH_SALT=

SITE_B_DB_NAME=
SITE_B_DB_USER=
SITE_B_DB_PASSWORD=
SITE_B_DB_HOST=
SITE_B_DB_PORT=3306
SITE_B_HASH_SALT=
