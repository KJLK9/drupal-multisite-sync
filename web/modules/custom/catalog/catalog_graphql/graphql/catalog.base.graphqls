type Money {
  number: String
  currencyCode: String
}

type Customer {
  id: ID!
  uuid: String
  label: String
  customerNumber: String
  status: Boolean
  description: String
  """
  Prices for this item: `limit` defaults to 50 and is clamped to 1..100. The
  total counts all prices the current user may view.
  """
  prices(limit: Int! = 50): ProductPriceList!
}

type Product {
  id: ID!
  uuid: String
  label: String
  status: Boolean
  description: String
  basePrice: Money
  """
  Prices for this item: `limit` defaults to 50 and is clamped to 1..100. The
  total counts all prices the current user may view.
  """
  prices(limit: Int! = 50): ProductPriceList!
}

type ProductPrice {
  id: ID!
  uuid: String
  product: Product
  customer: Customer
  price: Money
}

"""
Lists share one shape: a page of `items` and the number of matches in total,
so clients know when to stop paging. Totals count what the current user may
see: unpublished items, and prices of products or customers the user may not
view, are excluded.
"""
type CustomerList {
  items: [Customer!]!
  totalCount: Int!
}

type ProductList {
  items: [Product!]!
  totalCount: Int!
}

type ProductPriceList {
  items: [ProductPrice!]!
  totalCount: Int!
}
